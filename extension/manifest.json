{
  "manifest_version": 3,
  "name": "Mini Download Manager",
  "version": "0.2.0",
  "description": "Passa i download grandi all'app MDM invece di scaricarli in Chrome.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "cookies", "nativeMessaging", "storage", "alarms", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "MDM: click per attivare/disattivare" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
